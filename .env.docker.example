# Docker environment template based on .env.docker.
# Copy to .env.docker and replace placeholders; keep actual credentials private.
# After copying, start the development stack with:
# docker compose --env-file .env.docker -f compose.dev.yaml up --build
# Compose uses .env.docker for interpolation and passes it to the backend via env_file.
# See .env.example for the complete set of supported Django settings, including SMTP and Azure.

# Generate a unique secret key before use.
SECRET_KEY=replace-with-a-unique-django-secret-key

# Use False for deployment; True is for local development only.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=replace-with-your-database-password
DB_HOST=db
DB_PORT=5432

# Browser-facing frontend origins, including scheme and port (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Browser-facing Stripe return origin; HTTPS is required outside localhost.
STRIPE_FRONTEND_ORIGIN=http://localhost:5173
# Optional Stripe test checkout. Supply test keys only; never use live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CELERY
CELERY_BROKER_URL=redis://redis:6379/0

# False uses filesystem media storage; compose.dev.yaml persists media/ in media_data.
# Set True and supply all three Azure values to use Azure Blob Storage instead.
USE_AZURE_STORAGE=False
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=

# Console email is for local testing; configure SMTP delivery for deployment.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# To send email, select django.core.mail.backends.smtp.EmailBackend and fill in SMTP settings.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="E-Commerce <noreply@example.com>"

# PG ADMIN
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-your-pgadmin-password

# Enable only when database and all media are disposable.
ALLOW_DEV_RESET=False
