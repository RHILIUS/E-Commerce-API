# The official image substitutes only PUBLIC_HTTPS_ORIGIN, preserving Nginx variables.
server {
    listen 80;
    server_name _;
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 308 ${PUBLIC_HTTPS_ORIGIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 10m;
    access_log off;

    location /static/ {
        alias /srv/static/;
    }

    # Fallback for filesystem storage; Azure deployments return Azure media URLs.
    location /media/ {
        alias /srv/media/;
    }

    location ~ ^/(api|admin)(/|$) {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    # The frontend is hosted separately; this host serves only backend routes.
    location / {
        return 404;
    }
}
