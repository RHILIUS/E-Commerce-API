# Workstation configuration. Copy to .env.deploy; never commit actual settings.
# Literal KEY=value only; optional surrounding quotes. No expansion or inline comments.
# Relative file paths resolve against this configuration file's directory.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=ubuntu
SSH_KEY_FILE=/absolute/path/to/vm-key.pem
# Obtain server host keys through a trusted console/session, not blind ssh-keyscan.
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/verified-vm-known-hosts
DEPLOY_PATH=/home/ubuntu/ecommerce/backend
API_DOMAIN=api.example.com

# Bootstrap only. This repository key is separate from your VM login key.
REPOSITORY=git@github.com:RHILIUS/E-Commerce-API.git
CERTIFICATE_EMAIL=operator@example.com
APP_ENV_FILE=/absolute/path/to/prepared-backend.env
GIT_KEY_FILE=/absolute/path/to/read-only-repository-key
GIT_KNOWN_HOSTS_FILE=/absolute/path/to/verified-github-known-hosts
# Optional: authorize this existing GitHub Actions VM login public key.
ACTIONS_PUBLIC_KEY_FILE=
