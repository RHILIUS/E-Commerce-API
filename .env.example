# Single environment file for host Django, Docker Compose and VS Code.
# Copy to .env and replace secret/password placeholders.
# Django: generate a unique SECRET_KEY for each environment.
# Keep DEBUG=False for deployment; use True only for local development.
# Refresh cookies require HTTPS when DEBUG=False.
SECRET_KEY=replace-with-a-unique-django-secret-key
DEBUG=True
# Comma-separated backend hostnames, without schemes or paths.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: provision the database/user and supply their actual credentials.
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=replace-with-your-database-password
# Compose overrides DB_HOST=db and DB_PORT=5432 inside backend containers.
DB_HOST=localhost
DB_PORT=5432

# Comma-separated browser origins, including scheme and port.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave at zero unless deployed behind a known number of trusted proxies.
TRUSTED_PROXY_COUNT=0

# Configure SMTP delivery for deployed registration and password-change emails.
# For local development, use django.core.mail.backends.console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="E-Commerce <noreply@example.com>"

# Catalog popularity window (days) and exchange-rate request timeouts (seconds).
PRODUCT_POPULARITY_DAYS=7
CATALOG_FX_TIMEOUT_SECONDS=2
CHECKOUT_FX_TIMEOUT_SECONDS=2

# Filesystem media storage is the default; deployments must persist and serve media/.
# For Azure Blob Storage, enable this and supply all three Azure values below.
USE_AZURE_STORAGE=False
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=

# Use a test secret key and the signing secret for your webhook endpoint/CLI listener.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Frontend origin used for Stripe return URLs; HTTPS is required outside localhost.
STRIPE_FRONTEND_ORIGIN=http://localhost:5173

# Enable only when database and all media are disposable, including portfolio deployments.
ALLOW_DEV_RESET=False

# Local Docker pgAdmin login (separate from PostgreSQL credentials).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-your-pgadmin-password

# CELERY BROKER
CELERY_BROKER_URL=redis://redis:6379/0

# Production Compose uses the same .env, with an isolated project and volumes.
# Settings force DEBUG=False and trust the private Nginx proxy.
# ALLOW_DEV_RESET remains an explicit .env opt-in; it defaults to False.
# TLS material: deploy/certs/fullchain.pem and deploy/certs/privkey.pem (not committed).
PROD_BIND_ADDRESS=127.0.0.1
PROD_HTTP_PORT=8080
PROD_HTTPS_PORT=8443
PUBLIC_HTTPS_ORIGIN=https://localhost:8443
# Include the exact public origin for Django admin/forms behind the proxy.
CSRF_TRUSTED_ORIGINS=https://localhost:8443

# Optional shared secret with Pages runtime; at least 32 random bytes.
# Blank disables country hints. Never use this for authentication or payment policy.
COUNTRY_HINT_SECRET=
