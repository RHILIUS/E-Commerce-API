# Django: generate a unique SECRET_KEY for each environment.
# Keep DEBUG=False for deployment; use True only for local development.
# Refresh cookies require HTTPS when DEBUG=False.
SECRET_KEY=replace-with-a-unique-django-secret-key
DEBUG=False
# Comma-separated backend hostnames, without schemes or paths.
ALLOWED_HOSTS=api.example.com

# PostgreSQL: provision the database/user and supply their actual credentials.
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=replace-with-your-database-password
DB_HOST=database.example.com
DB_PORT=5432

# Comma-separated browser origins, including scheme and port.
CORS_ALLOWED_ORIGINS=https://shop.example.com
# Leave at zero unless deployed behind a known number of trusted proxies.
TRUSTED_PROXY_COUNT=0

# Configure SMTP delivery for deployed registration and password-change emails.
# For local development, use django.core.mail.backends.console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="E-Commerce <noreply@example.com>"

# Catalog popularity window (days) and exchange-rate request timeouts (seconds).
PRODUCT_POPULARITY_DAYS=7
CATALOG_FX_TIMEOUT_SECONDS=2
CHECKOUT_FX_TIMEOUT_SECONDS=2

# Filesystem media storage is the default; deployments must persist and serve media/.
# For Azure Blob Storage, enable this and supply all three Azure values below.
USE_AZURE_STORAGE=False
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=

# Use a test secret key and the signing secret for your webhook endpoint/CLI listener.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Frontend origin used for Stripe return URLs; HTTPS is required outside localhost.
STRIPE_FRONTEND_ORIGIN=https://shop.example.com
